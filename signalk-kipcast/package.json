{
  "name": "signalk-kipcast",
  "version": "0.2.0",
  "description": "Cast live KIP dashboards to low-cost ESP32 touchscreens, with touch passed back to KIP",
  "main": "index.js",
  "files": [
    "index.js",
    "standalone.js",
    "lib/",
    "public/",
    "images/",
    "test/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-instruments",
    "kip",
    "esp32"
  ],
  "scripts": {
    "start": "node standalone.js",
    "test": "node --test test/*.test.js"
  },
  "author": "Mike G0KAD",
  "homepage": "https://github.com/g0kad/KIPCast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0kad/KIPCast.git",
    "directory": "signalk-kipcast"
  },
  "bugs": {
    "url": "https://github.com/g0kad/KIPCast/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "puppeteer-core": "^25.11.0",
    "ws": "^8.18.0"
  },
  "signalk": {
    "displayName": "KIPCast",
    "appIcon": "icon.svg",
    "screenshots": [
      "./images/windsteer.jpeg",
      "./images/battery.jpeg",
      "./images/switches.jpeg"
    ]
  }
}
